<mjml>
    <mj-head>
        <mj-title>{{ title }}</mj-title>

        <mj-style inline="inline">
            h3 {
            font-size: 18px;
            color: #555;
            font-weight: normal;
            }
        </mj-style>
    </mj-head>

    <mj-body background-color="#f4f4f4">
        <mj-section background-color="#f4f4f4" padding="28px 0 22px 0">
            <mj-column>
                <mj-text
                        align="center"
                        color="#1c1c1e"
                        font-family="Helvetica, Arial, sans-serif"
                        font-size="24px"
                        font-weight="700"
                        letter-spacing="4px"
                        padding="0"
                >
                    BEAST LOCKER
                </mj-text>

                <mj-text
                        align="center"
                        color="#6a6a6a"
                        font-family="Helvetica, Arial, sans-serif"
                        font-size="11px"
                        font-weight="400"
                        letter-spacing="3px"
                        text-transform="uppercase"
                        padding="8px 0 0 0"
                >
                    RESERVED ONLY FOR THE MOTIVATED
                </mj-text>
            </mj-column>
        </mj-section>