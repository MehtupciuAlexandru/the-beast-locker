APP_ENV=dev
PORT=3000
COOKIE_SECRET=replace-with-random-secret
SUPERADMIN_USERNAME=admin@example.com
SUPERADMIN_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5440
DB_NAME=beastDB
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_SCHEMA=public

# Colete Online API. Keep staging while testing locally.
COLETE_ONLINE_ENV=staging
COLETE_ONLINE_CLIENT_ID=
COLETE_ONLINE_CLIENT_SECRET=
# Staging order creation currently supports only TNT, according to Colete's docs.
# Colete's service list reports TNT Domestic Express as service ID 6.
COLETE_ONLINE_SERVICE_IDS=6
# Optional checkout address-delivery service filter. Leave empty to let Colete
# return the best available direct-to-address service for /order/price.
COLETE_ONLINE_ADDRESS_SERVICE_IDS=
# Locker/pickup-point service IDs used when listing lockers. Colete's docs
# examples use Sameday EasyBox-style services 203 and 205.
COLETE_ONLINE_LOCKER_SERVICE_IDS=203,205
# Set false when testing production pricing but you do not want dashboard AWB
# generation to create real Colete orders.
COLETE_AWB_GENERATION_ENABLED=true
# On startup, switch these Vendure shipping methods from flat-rate pricing to
# the Colete quote calculator. Set false if you want to manage this manually.
COLETE_SYNC_SHIPPING_METHODS=true
COLETE_SHIPPING_METHOD_CODES=standard-shipping,express-shipping

# Checkout quote defaults. Colete requires package dimensions for /order/price,
# so these are only used to estimate checkout shipping before the warehouse
# confirms the real parcel dimensions for AWB generation.
COLETE_CHECKOUT_PACKAGE_WEIGHT_KG=1
COLETE_CHECKOUT_PACKAGE_LENGTH_CM=30
COLETE_CHECKOUT_PACKAGE_WIDTH_CM=20
COLETE_CHECKOUT_PACKAGE_HEIGHT_CM=10
COLETE_CHECKOUT_PACKAGE_CONTENT=Sport equipment

# Sender/warehouse address used when creating Colete Online orders.
# For staging-only tests before the real warehouse address is known, you can
# use dummy sender values. Do not use these in production.
COLETE_USE_DUMMY_SENDER=false

# Instead of these address fields, set COLETE_SENDER_ADDRESS_ID if this
# address is already saved in Colete Online.
COLETE_SENDER_NAME=Colete Staging Sender
COLETE_SENDER_PHONE=0722222222
COLETE_SENDER_EMAIL=test@example.com
COLETE_SENDER_COMPANY=Beast Locker Test
COLETE_SENDER_COUNTRY_CODE=RO
COLETE_SENDER_POSTAL_CODE=300375
COLETE_SENDER_CITY=Timișoara
COLETE_SENDER_COUNTY=Timiș
COLETE_SENDER_STREET=Piața Avram Iancu
COLETE_SENDER_NUMBER=6
COLETE_SENDER_VALIDATION_STRATEGY=minimal
