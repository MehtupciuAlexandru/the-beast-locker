# Copy only the section you need; do not load production and local together.

# PRODUCTION
APP_ENV="production" # Runtime mode.
APP_URL="https://the-beast-locker-production.up.railway.app" # Railway backend URL.
COLETE_AWB_GENERATION_ENABLED="false" # Enable shipping-order creation.
COLETE_CHECKOUT_PACKAGE_CONTENT="Sport equipment" # Your parcel contents.
COLETE_CHECKOUT_PACKAGE_HEIGHT_CM="10" # Your estimated parcel height.
COLETE_CHECKOUT_PACKAGE_LENGTH_CM="30" # Your estimated parcel length.
COLETE_CHECKOUT_PACKAGE_WEIGHT_KG="1" # Your estimated parcel weight.
COLETE_CHECKOUT_PACKAGE_WIDTH_CM="20" # Your estimated parcel width.
COLETE_ONLINE_ADDRESS_SERVICE_IDS="" # Colete address-delivery service IDs.
COLETE_ONLINE_CLIENT_ID= # Colete Online API client ID.
COLETE_ONLINE_CLIENT_SECRET= # Colete Online API client secret.
COLETE_ONLINE_ENV="production" # Colete API environment.
COLETE_ONLINE_LOCKER_SELECTION_TYPE="showClosest" # Colete locker-selection strategy.
COLETE_ONLINE_LOCKER_SERVICE_IDS="203,205" # Colete locker service IDs.
COLETE_ONLINE_SELECTION_TYPE="bestPrice" # Colete service-selection strategy.
COLETE_SENDER_CITY= # Your warehouse city.
COLETE_SENDER_COMPANY="Beast Locker Test" # Your warehouse company.
COLETE_SENDER_COUNTRY_CODE="RO" # Your warehouse country code.
COLETE_SENDER_COUNTY= # Your warehouse county.
COLETE_SENDER_EMAIL="test@example.com" # Your warehouse email.
COLETE_SENDER_NAME="Colete TESTING Sender" # Your warehouse name.
COLETE_SENDER_NUMBER="6" # Your warehouse number.
COLETE_SENDER_PHONE="0722222222" # Your warehouse phone.
COLETE_SENDER_POSTAL_CODE= # Your warehouse postal code.
COLETE_SENDER_STREET= # Your warehouse street.
COLETE_SENDER_VALIDATION_STRATEGY="minimal" # Colete address-validation strategy.
COLETE_USE_DUMMY_SENDER="false" # Use test sender in staging only.
COOKIE_SECRET= # Generate a random secret.
DATABASE_PUBLIC_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}/${{PGDATABASE}}" # Railway public database connection URL.
DATABASE_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}" # Railway private database connection URL.
DB_HOST="${{Postgres.PGHOST}}" # Railway Postgres PGHOST.
DB_NAME="${{Postgres.PGDATABASE}}" # Railway Postgres PGDATABASE.
DB_PASSWORD="${{Postgres.PGPASSWORD}}" # Railway Postgres PGPASSWORD.
DB_PORT="${{Postgres.PGPORT}}" # Railway Postgres PGPORT.
DB_SCHEMA="public" # PostgreSQL schema.
DB_USERNAME="${{Postgres.PGUSER}}" # Railway Postgres PGUSER.
FRONTEND_URL="https://beast-locker.ro" # Deployed storefront URL.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY= # Google reCAPTCHA site key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # Stripe dashboard publishable key.
PGDATA="/var/lib/postgresql/data/pgdata" # Railway Postgres data directory.
PGDATABASE="${{POSTGRES_DB}}" # Railway Postgres database name.
PGHOST="${{RAILWAY_PRIVATE_DOMAIN}}" # Railway Postgres hostname.
PGPASSWORD="${{POSTGRES_PASSWORD}}" # Railway Postgres password.
PGPORT="5432" # Railway Postgres port.
PGUSER="${{POSTGRES_USER}}" # Railway Postgres username.
POSTGRES_DB="railway" # Railway database initialization name.
POSTGRES_PASSWORD= # Railway database initialization password.
POSTGRES_USER="postgres" # Railway database initialization user.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS="60" # Railway shutdown grace period.
RECAPTCHA_SECRET_KEY= # Google reCAPTCHA secret key.
RESEND_API_KEY= # Resend dashboard API key.
S3_ACCESS_KEY_ID= # Supabase Storage S3 access key.
S3_BUCKET="assets" # Your storage bucket name.
S3_ENDPOINT= # Supabase Storage S3 endpoint.
S3_FORCE_PATH_STYLE="true" # S3 path-style setting.
S3_REGION= # Supabase Storage region.
S3_SECRET_ACCESS_KEY= # Supabase Storage S3 secret key.
SSL_CERT_DAYS="820" # Certificate validity setting.
SUPERADMIN_PASSWORD= # Choose the Vendure admin password.
SUPERADMIN_USERNAME="beastlocker@superadmin.com" # Choose the Vendure admin login.
VENDURE_SHOP_API_URL="https://the-beast-locker-production.up.railway.app/shop-api" # Backend URL plus /shop-api.

